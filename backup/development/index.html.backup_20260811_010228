<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>WinWatch Security Dashboard</title>

<style>
:root {
    --bg: #050b14;
    --bg-2: #08111f;
    --surface: rgba(13, 27, 46, 0.88);
    --surface-2: rgba(18, 37, 61, 0.78);
    --surface-hover: rgba(25, 49, 79, 0.90);

    --border: rgba(107, 154, 205, 0.18);
    --border-bright: rgba(79, 183, 255, 0.34);

    --text: #f1f6fd;
    --text-soft: #b6c7da;
    --muted: #7890aa;

    --cyan: #39bdf8;
    --blue: #5d8cff;
    --green: #3ddc97;
    --red: #ff647c;
    --orange: #ffb454;
    --purple: #a78bfa;

    --shadow:
        0 18px 50px rgba(0, 0, 0, 0.28);
}

* {
    box-sizing: border-box;
}

html {
    color-scheme: dark;
}

body {
    margin: 0;
    min-height: 100vh;

    font-family:
        Inter,
        "Segoe UI",
        system-ui,
        -apple-system,
        sans-serif;

    color: var(--text);

    background:
        radial-gradient(
            circle at 82% 0%,
            rgba(44, 91, 170, 0.19),
            transparent 28%
        ),
        radial-gradient(
            circle at 12% 20%,
            rgba(57, 189, 248, 0.08),
            transparent 26%
        ),
        linear-gradient(
            180deg,
            #060d18,
            var(--bg)
        );

    background-attachment: fixed;
}

body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: 0.22;

    background-image:
        linear-gradient(
            rgba(255, 255, 255, 0.018) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.018) 1px,
            transparent 1px
        );

    background-size: 34px 34px;
}

.dashboard {
    position: relative;
    z-index: 1;

    width: min(1580px, calc(100% - 40px));
    margin: 0 auto;
    padding: 26px 0 40px;
}

/* =========================================================
   HEADER
   ========================================================= */

.topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;

    margin-bottom: 24px;
}

.brand {
    display: flex;
    align-items: center;
    gap: 15px;
    min-width: 0;
}

.logo {
    width: 50px;
    height: 50px;

    display: grid;
    place-items: center;

    border-radius: 15px;

    color: var(--cyan);

    border: 1px solid var(--border-bright);

    background:
        linear-gradient(
            145deg,
            rgba(57, 189, 248, 0.16),
            rgba(93, 140, 255, 0.08)
        );

    box-shadow:
        0 0 30px rgba(57, 189, 248, 0.09);
}

.logo svg {
    width: 27px;
    height: 27px;
}

.brand-copy {
    min-width: 0;
}

.brand-copy h1 {
    margin: 0;

    font-size: clamp(23px, 2vw, 30px);
    letter-spacing: -0.6px;
}

.brand-copy p {
    margin: 5px 0 0;
    color: var(--muted);
    font-size: 13px;
}

.header-status {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
}

.status-pill,
.meta-pill {
    min-height: 40px;

    display: inline-flex;
    align-items: center;
    gap: 9px;

    padding: 0 14px;

    border: 1px solid var(--border);
    border-radius: 11px;

    background: rgba(10, 22, 38, 0.82);

    color: var(--text-soft);
    font-size: 12px;
}

.status-pill {
    color: #bdf8da;
    border-color: rgba(61, 220, 151, 0.25);
}

.status-dot {
    width: 9px;
    height: 9px;

    flex: 0 0 auto;

    border-radius: 50%;

    background: var(--green);

    box-shadow:
        0 0 0 4px rgba(61, 220, 151, 0.08),
        0 0 12px var(--green);

    animation: pulse 2s infinite;
}

@keyframes pulse {
    50% {
        opacity: 0.55;
        transform: scale(0.9);
    }
}

/* =========================================================
   KPI
   ========================================================= */

.kpi-grid {
    display: grid;

    grid-template-columns:
        repeat(5, minmax(0, 1fr));

    gap: 14px;

    margin-bottom: 16px;
}

.kpi {
    position: relative;
    overflow: hidden;

    min-height: 126px;

    padding: 18px;

    border-radius: 15px;
    border: 1px solid var(--border);

    background:
        linear-gradient(
            145deg,
            rgba(17, 35, 58, 0.94),
            rgba(9, 20, 36, 0.94)
        );

    box-shadow: var(--shadow);
}

.kpi::after {
    content: "";

    position: absolute;

    width: 110px;
    height: 110px;

    top: -50px;
    right: -45px;

    border-radius: 50%;

    background: var(--glow);
    filter: blur(8px);
    opacity: 0.12;
}

.kpi-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 10px;
}

.kpi-label {
    color: var(--muted);

    font-size: 11px;
    font-weight: 700;

    letter-spacing: 0.9px;
    text-transform: uppercase;
}

.kpi-icon {
    width: 31px;
    height: 31px;

    display: grid;
    place-items: center;

    color: var(--accent);

    border: 1px solid color-mix(
        in srgb,
        var(--accent) 25%,
        transparent
    );

    border-radius: 9px;

    background: color-mix(
        in srgb,
        var(--accent) 9%,
        transparent
    );
}

.kpi-icon svg {
    width: 17px;
    height: 17px;
}

.kpi-value {
    margin-top: 13px;

    font-size: 30px;
    line-height: 1;
    font-weight: 750;

    color: var(--accent);
}

.kpi-sub {
    margin-top: 9px;

    color: var(--muted);
    font-size: 11px;
}

/* =========================================================
   PANELS
   ========================================================= */

.grid-primary {
    display: grid;

    grid-template-columns:
        minmax(0, 1.65fr)
        minmax(300px, 0.72fr);

    gap: 16px;

    margin-bottom: 16px;
}

.grid-secondary {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 16px;

    margin-bottom: 16px;
}

.panel {
    min-width: 0;

    border: 1px solid var(--border);
    border-radius: 16px;

    background:
        linear-gradient(
            145deg,
            rgba(16, 32, 53, 0.92),
            rgba(8, 19, 34, 0.94)
        );

    box-shadow: var(--shadow);
}

.panel-body {
    padding: 19px;
}

.panel-heading {
    min-height: 59px;

    padding: 0 19px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 12px;

    border-bottom:
        1px solid rgba(123, 163, 204, 0.10);
}

.panel-title {
    display: flex;
    align-items: center;
    gap: 10px;
}

.panel-title h2 {
    margin: 0;

    font-size: 14px;
    font-weight: 700;
}

.panel-title-icon {
    color: var(--cyan);
}

.panel-meta {
    color: var(--muted);
    font-size: 11px;
}

/* =========================================================
   EVENT OVERVIEW
   ========================================================= */

.event-overview {
    display: grid;

    grid-template-columns:
        210px minmax(0, 1fr);

    gap: 28px;
    align-items: center;
}

.donut-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.donut {
    position: relative;

    width: 165px;
    height: 165px;

    display: grid;
    place-items: center;

    border-radius: 50%;

    background:
        conic-gradient(
            #203047 0deg 360deg
        );
}

.donut::after {
    content: "";

    width: 116px;
    height: 116px;

    position: absolute;

    border-radius: 50%;

    border: 1px solid var(--border);

    background:
        linear-gradient(
            145deg,
            #0c1a2b,
            #07111e
        );
}

.donut-center {
    position: relative;
    z-index: 2;

    text-align: center;
}

.donut-total {
    display: block;

    font-size: 31px;
    font-weight: 800;
}

.donut-caption {
    display: block;

    margin-top: 3px;

    color: var(--muted);
    font-size: 10px;

    letter-spacing: 0.7px;
    text-transform: uppercase;
}

.distribution {
    min-width: 0;
}

.distribution-row {
    display: grid;

    grid-template-columns:
        150px minmax(100px, 1fr) 45px;

    align-items: center;

    gap: 11px;

    margin: 11px 0;
}

.distribution-name {
    overflow: hidden;

    color: var(--text-soft);

    text-overflow: ellipsis;
    white-space: nowrap;

    font-size: 11px;
    font-weight: 600;
}

.track {
    height: 7px;

    overflow: hidden;

    border-radius: 20px;

    background: rgba(3, 10, 19, 0.85);
}

.track-fill {
    height: 100%;

    border-radius: inherit;

    background:
        linear-gradient(
            90deg,
            var(--cyan),
            var(--purple)
        );

    box-shadow:
        0 0 10px rgba(57, 189, 248, 0.15);
}

.distribution-count {
    text-align: right;

    color: var(--muted);
    font-size: 11px;
}

/* =========================================================
   HOST PROFILE
   ========================================================= */

.host-name {
    margin-bottom: 17px;

    font-size: 18px;
    font-weight: 700;
}

.host-name span {
    display: block;

    margin-top: 4px;

    color: var(--muted);
    font-size: 11px;
    font-weight: 400;
}

.health-row {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 12px;

    padding: 11px 0;

    border-bottom:
        1px solid rgba(255, 255, 255, 0.055);

    font-size: 12px;
}

.health-row:last-child {
    border-bottom: none;
}

.health-label {
    color: var(--muted);
}

.health-value {
    font-weight: 600;
}

.health-good {
    color: var(--green);
}

/* =========================================================
   RANKINGS
   ========================================================= */

.ranking {
    margin: 0;
    padding: 0;

    list-style: none;
}

.ranking-item {
    display: grid;

    grid-template-columns:
        33px minmax(0, 1fr) auto;

    gap: 11px;
    align-items: center;

    padding: 12px 0;

    border-bottom:
        1px solid rgba(255, 255, 255, 0.055);
}

.ranking-item:last-child {
    border-bottom: 0;
}

.rank-number {
    width: 28px;
    height: 28px;

    display: grid;
    place-items: center;

    border-radius: 8px;

    color: var(--cyan);
    background: rgba(57, 189, 248, 0.08);

    font-size: 11px;
    font-weight: 700;
}

.rank-info {
    min-width: 0;
}

.rank-name {
    overflow: hidden;

    color: var(--text-soft);

    text-overflow: ellipsis;
    white-space: nowrap;

    font-size: 12px;
}

.rank-bar {
    height: 4px;

    margin-top: 7px;

    overflow: hidden;

    border-radius: 20px;

    background: rgba(0, 0, 0, 0.3);
}

.rank-bar-fill {
    height: 100%;

    border-radius: inherit;

    background:
        linear-gradient(
            90deg,
            var(--blue),
            var(--cyan)
        );
}

.rank-count {
    padding-left: 10px;

    color: var(--muted);

    font-size: 12px;
    font-weight: 600;
}

/* =========================================================
   EVENT STREAM
   ========================================================= */

.events-panel {
    overflow: hidden;
}

.events-toolbar {
    display: flex;
    align-items: center;
    gap: 10px;
}

.search-box,
.event-filter {
    height: 35px;

    color: var(--text-soft);
    background: rgba(5, 14, 25, 0.75);

    border: 1px solid var(--border);
    border-radius: 9px;

    outline: none;

    font-family: inherit;
    font-size: 11px;
}

.search-box {
    width: 230px;
    padding: 0 12px;
}

.event-filter {
    padding: 0 10px;
}

.search-box:focus,
.event-filter:focus {
    border-color: var(--border-bright);

    box-shadow:
        0 0 0 3px rgba(57, 189, 248, 0.07);
}

.table-container {
    overflow-x: auto;
}

table {
    width: 100%;
    min-width: 1000px;

    border-collapse: collapse;
}

thead {
    background: rgba(7, 17, 30, 0.64);
}

th {
    padding: 11px 15px;

    text-align: left;

    color: var(--muted);

    font-size: 10px;
    font-weight: 700;

    letter-spacing: 0.7px;
    text-transform: uppercase;
}

td {
    padding: 12px 15px;

    border-top:
        1px solid rgba(255, 255, 255, 0.045);

    color: var(--text-soft);

    font-size: 11px;
    vertical-align: middle;
}

tbody tr {
    transition:
        background 0.15s ease;
}

tbody tr:hover {
    background:
        rgba(57, 189, 248, 0.038);
}

.event-badge {
    display: inline-flex;
    align-items: center;

    min-height: 25px;

    padding: 0 8px;

    border-radius: 6px;

    font-size: 10px;
    font-weight: 750;
    letter-spacing: 0.3px;

    border: 1px solid transparent;
}

.event-process {
    color: #70e2ac;
    background: rgba(61, 220, 151, 0.08);
    border-color: rgba(61, 220, 151, 0.18);
}

.event-network {
    color: #7dc9ff;
    background: rgba(57, 189, 248, 0.08);
    border-color: rgba(57, 189, 248, 0.18);
}

.event-login-success {
    color: #a2f2ca;
    background: rgba(61, 220, 151, 0.08);
    border-color: rgba(61, 220, 151, 0.18);
}

.event-login-failure {
    color: #ff8fa1;
    background: rgba(255, 100, 124, 0.09);
    border-color: rgba(255, 100, 124, 0.20);
}

.event-file {
    color: #ffd086;
    background: rgba(255, 180, 84, 0.08);
    border-color: rgba(255, 180, 84, 0.18);
}

.event-dns {
    color: #c1afff;
    background: rgba(167, 139, 250, 0.08);
    border-color: rgba(167, 139, 250, 0.18);
}

.event-default {
    color: var(--text-soft);
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--border);
}

.mono {
    font-family:
        "Cascadia Code",
        Consolas,
        monospace;
}

.empty {
    padding: 28px;

    text-align: center;

    color: var(--muted);
}

/* =========================================================
   FOOTER
   ========================================================= */

footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;

    gap: 10px;

    margin-top: 17px;

    color: var(--muted);
    font-size: 10px;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1200px) {
    .kpi-grid {
        grid-template-columns:
            repeat(3, minmax(0, 1fr));
    }

    .grid-primary {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 850px) {
    .dashboard {
        width: min(100% - 24px, 1580px);
    }

    .topbar {
        align-items: flex-start;
        flex-direction: column;
    }

    .header-status {
        justify-content: flex-start;
    }

    .kpi-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .grid-secondary {
        grid-template-columns: 1fr;
    }

    .event-overview {
        grid-template-columns: 1fr;
    }

    .events-toolbar {
        width: 100%;
        flex-wrap: wrap;
    }
}

@media (max-width: 520px) {
    .kpi-grid {
        grid-template-columns: 1fr;
    }

    .distribution-row {
        grid-template-columns:
            115px 1fr 35px;
    }
}
</style>
</head>

<body>

<main class="dashboard">

    <header class="topbar">

        <div class="brand">

            <div class="logo">
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                >
                    <path
                        d="M12 3 19 6v5c0 4.8-2.8 8.2-7 10-4.2-1.8-7-5.2-7-10V6l7-3Z"
                    />
                    <path d="M8.5 12h2l1-3 2 6 1-3h2" />
                </svg>
            </div>

            <div class="brand-copy">
                <h1>WinWatch Security Dashboard</h1>

                <p>
                    Real-Time Windows Activity Monitoring
                    · Python Security Telemetry
                    · Nguyễn Thành Nhân
                </p>
            </div>

        </div>

        <div class="header-status">

            <div class="meta-pill">
                TCP Collector
                <strong>5514</strong>
            </div>

            <div class="meta-pill">
                Dashboard
                <strong>:8080</strong>
            </div>

            <div class="status-pill">
                <span
                    class="status-dot"
                    id="status-dot"
                ></span>

                <span id="status-text">
                    Connecting
                </span>
            </div>

        </div>

    </header>


    <section class="kpi-grid">

        <article
            class="kpi"
            style="
                --accent: var(--cyan);
                --glow: var(--cyan);
            "
        >
            <div class="kpi-header">
                <span class="kpi-label">
                    Total Events
                </span>

                <span class="kpi-icon">
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                    >
                        <path d="M4 5h16v14H4z"/>
                        <path d="M8 9h8M8 13h5"/>
                    </svg>
                </span>
            </div>

            <div
                class="kpi-value"
                id="kpi-total"
            >
                0
            </div>

            <div class="kpi-sub">
                Runtime telemetry collected
            </div>
        </article>


        <article
            class="kpi"
            style="
                --accent: var(--green);
                --glow: var(--green);
            "
        >
            <div class="kpi-header">
                <span class="kpi-label">
                    Process Events
                </span>

                <span class="kpi-icon">
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                    >
                        <rect
                            x="5"
                            y="5"
                            width="14"
                            height="14"
                            rx="2"
                        />
                        <path d="M9 9h6v6H9z"/>
                    </svg>
                </span>
            </div>

            <div
                class="kpi-value"
                id="kpi-process"
            >
                0
            </div>

            <div class="kpi-sub">
                Create + terminate activity
            </div>
        </article>


        <article
            class="kpi"
            style="
                --accent: var(--blue);
                --glow: var(--blue);
            "
        >
            <div class="kpi-header">
                <span class="kpi-label">
                    Network Connections
                </span>

                <span class="kpi-icon">
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                    >
                        <circle cx="12" cy="12" r="8"/>
                        <path d="M4 12h16M12 4c2 2.2 3 4.8 3 8s-1 5.8-3 8M12 4c-2 2.2-3 4.8-3 8s1 5.8 3 8"/>
                    </svg>
                </span>
            </div>

            <div
                class="kpi-value"
                id="kpi-network"
            >
                0
            </div>

            <div class="kpi-sub">
                Sysmon network telemetry
            </div>
        </article>


        <article
            class="kpi"
            style="
                --accent: var(--red);
                --glow: var(--red);
            "
        >
            <div class="kpi-header">
                <span class="kpi-label">
                    Login Failures
                </span>

                <span class="kpi-icon">
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                    >
                        <circle cx="12" cy="8" r="3"/>
                        <path d="M6 19c.8-3 2.8-5 6-5s5.2 2 6 5"/>
                        <path d="m18 8 3 3M21 8l-3 3"/>
                    </svg>
                </span>
            </div>

            <div
                class="kpi-value"
                id="kpi-login"
            >
                0
            </div>

            <div class="kpi-sub">
                Windows Event ID 4625
            </div>
        </article>


        <article
            class="kpi"
            style="
                --accent: var(--purple);
                --glow: var(--purple);
            "
        >
            <div class="kpi-header">
                <span class="kpi-label">
                    Unique Processes
                </span>

                <span class="kpi-icon">
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                    >
                        <path d="M5 7h14M5 12h14M5 17h14"/>
                        <circle cx="8" cy="7" r="1"/>
                        <circle cx="15" cy="12" r="1"/>
                        <circle cx="11" cy="17" r="1"/>
                    </svg>
                </span>
            </div>

            <div
                class="kpi-value"
                id="kpi-process-unique"
            >
                0
            </div>

            <div class="kpi-sub">
                Distinct executable names
            </div>
        </article>

    </section>


    <section class="grid-primary">

        <article class="panel">

            <div class="panel-heading">
                <div class="panel-title">
                    <span class="panel-title-icon">
                        ◈
                    </span>

                    <h2>
                        Event Telemetry Distribution
                    </h2>
                </div>

                <span class="panel-meta">
                    Live runtime dataset
                </span>
            </div>

            <div class="panel-body event-overview">

                <div class="donut-wrap">

                    <div
                        class="donut"
                        id="event-donut"
                    >
                        <div class="donut-center">
                            <span
                                class="donut-total"
                                id="donut-total"
                            >
                                0
                            </span>

                            <span class="donut-caption">
                                Events
                            </span>
                        </div>
                    </div>

                </div>

                <div
                    class="distribution"
                    id="distribution"
                >
                    <div class="empty">
                        Waiting for telemetry...
                    </div>
                </div>

            </div>

        </article>


        <article class="panel">

            <div class="panel-heading">
                <div class="panel-title">
                    <span class="panel-title-icon">
                        ◉
                    </span>

                    <h2>
                        Endpoint Health
                    </h2>
                </div>

                <span class="panel-meta">
                    Sensor status
                </span>
            </div>

            <div class="panel-body">

                <div
                    class="host-name"
                    id="host-name"
                >
                    Waiting for endpoint...

                    <span>
                        Latest monitored Windows host
                    </span>
                </div>

                <div class="health-row">
                    <span class="health-label">
                        Windows Agent
                    </span>

                    <span
                        class="health-value health-good"
                        id="agent-health"
                    >
                        ONLINE
                    </span>
                </div>

                <div class="health-row">
                    <span class="health-label">
                        Dashboard API
                    </span>

                    <span
                        class="health-value health-good"
                        id="api-health"
                    >
                        ONLINE
                    </span>
                </div>

                <div class="health-row">
                    <span class="health-label">
                        Unique Destination IPs
                    </span>

                    <span
                        class="health-value"
                        id="unique-ip"
                    >
                        0
                    </span>
                </div>

                <div class="health-row">
                    <span class="health-label">
                        Data Validation Errors
                    </span>

                    <span
                        class="health-value"
                        id="data-errors"
                    >
                        0
                    </span>
                </div>

                <div class="health-row">
                    <span class="health-label">
                        Auto Refresh
                    </span>

                    <span class="health-value">
                        2 seconds
                    </span>
                </div>

            </div>

        </article>

    </section>


    <section class="grid-secondary">

        <article class="panel">

            <div class="panel-heading">
                <div class="panel-title">
                    <span class="panel-title-icon">
                        ⌘
                    </span>

                    <h2>
                        Top Processes
                    </h2>
                </div>

                <span class="panel-meta">
                    Most active executables
                </span>
            </div>

            <div class="panel-body">

                <ol
                    class="ranking"
                    id="process-ranking"
                ></ol>

            </div>

        </article>


        <article class="panel">

            <div class="panel-heading">
                <div class="panel-title">
                    <span class="panel-title-icon">
                        ◎
                    </span>

                    <h2>
                        Top Destination IPs
                    </h2>
                </div>

                <span class="panel-meta">
                    Network destinations
                </span>
            </div>

            <div class="panel-body">

                <ol
                    class="ranking"
                    id="ip-ranking"
                ></ol>

            </div>

        </article>

    </section>


    <section class="panel events-panel">

        <div class="panel-heading">

            <div class="panel-title">
                <span class="panel-title-icon">
                    ≋
                </span>

                <h2>
                    Live Windows Event Stream
                </h2>
            </div>

            <div class="events-toolbar">

                <input
                    class="search-box"
                    id="event-search"
                    type="search"
                    placeholder="Search event, process, user..."
                    aria-label="Search events"
                >

                <select
                    class="event-filter"
                    id="event-filter"
                    aria-label="Filter event type"
                >
                    <option value="">
                        All events
                    </option>
                </select>

            </div>

        </div>


        <div class="table-container">

            <table>

                <thead>
                <tr>
                    <th>Time</th>
                    <th>Hostname</th>
                    <th>Event Type</th>
                    <th>User / Process</th>
                    <th>Details</th>
                </tr>
                </thead>

                <tbody id="event-table">

                <tr>
                    <td
                        colspan="5"
                        class="empty"
                    >
                        Waiting for Windows telemetry...
                    </td>
                </tr>

                </tbody>

            </table>

        </div>

    </section>


    <footer>
        <span>
            WinWatch · Real-Time Windows Activity Monitoring System
        </span>

        <span id="last-update">
            Waiting for first update
        </span>
    </footer>

</main>


<script>
"use strict";

const REFRESH_INTERVAL = 2000;

let dashboardData = null;

const palette = [
    "#39bdf8",
    "#5d8cff",
    "#3ddc97",
    "#a78bfa",
    "#ffb454",
    "#ff647c",
    "#55d6be",
    "#809cff"
];


function escapeHtml(value) {
    return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
}


function getCount(data, eventType) {
    return Number(
        data.event_counts?.[eventType] ?? 0
    );
}


function eventBadgeClass(eventType) {

    if (eventType === "LOGIN_FAILURE") {
        return "event-login-failure";
    }

    if (eventType === "LOGIN_SUCCESS") {
        return "event-login-success";
    }

    if (eventType.includes("NETWORK")) {
        return "event-network";
    }

    if (eventType.includes("PROCESS")) {
        return "event-process";
    }

    if (eventType.includes("DNS")) {
        return "event-dns";
    }

    if (eventType.includes("FILE")) {
        return "event-file";
    }

    return "event-default";
}


function formatTimestamp(timestamp) {

    if (!timestamp) {
        return "-";
    }

    const date = new Date(timestamp);

    if (Number.isNaN(date.getTime())) {
        return timestamp;
    }

    return date.toLocaleTimeString(
        [],
        {
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit"
        }
    );
}


function renderKpis(data) {

    const processEvents =
        getCount(
            data,
            "PROCESS_CREATE"
        )
        +
        getCount(
            data,
            "PROCESS_TERMINATE"
        );

    document.getElementById(
        "kpi-total"
    ).textContent =
        data.total_events ?? 0;

    document.getElementById(
        "kpi-process"
    ).textContent =
        processEvents;

    document.getElementById(
        "kpi-network"
    ).textContent =
        data.network_connections ?? 0;

    document.getElementById(
        "kpi-login"
    ).textContent =
        data.login_failures ?? 0;

    document.getElementById(
        "kpi-process-unique"
    ).textContent =
        data.unique_processes ?? 0;
}


function renderDistribution(data) {

    const counts =
        Object.entries(
            data.event_counts ?? {}
        )
        .filter(
            ([, count]) =>
                Number(count) > 0
        )
        .sort(
            (a, b) =>
                b[1] - a[1]
        );

    const total =
        counts.reduce(
            (sum, [, count]) =>
                sum + Number(count),
            0
        );

    document.getElementById(
        "donut-total"
    ).textContent =
        total;

    const donut =
        document.getElementById(
            "event-donut"
        );

    const distribution =
        document.getElementById(
            "distribution"
        );

    if (counts.length === 0) {

        donut.style.background =
            "#15243a";

        distribution.innerHTML =
            '<div class="empty">' +
            'No events available.' +
            '</div>';

        return;
    }

    let cursor = 0;

    const segments = counts.map(
        ([, count], index) => {

            const start = cursor;

            const angle =
                total > 0
                    ? (
                        Number(count)
                        / total
                    ) * 360
                    : 0;

            cursor += angle;

            const color =
                palette[
                    index % palette.length
                ];

            return (
                `${color} ` +
                `${start}deg ` +
                `${cursor}deg`
            );
        }
    );

    donut.style.background =
        `conic-gradient(${segments.join(",")})`;

    const maxValue =
        Math.max(
            ...counts.map(
                ([, count]) =>
                    Number(count)
            ),
            1
        );

    distribution.innerHTML =
        counts.map(
            ([name, count], index) => {

                const percentage =
                    (
                        Number(count)
                        / maxValue
                    )
                    * 100;

                const color =
                    palette[
                        index % palette.length
                    ];

                return `
                    <div class="distribution-row">

                        <div
                            class="distribution-name"
                            title="${escapeHtml(name)}"
                        >
                            ${escapeHtml(name)}
                        </div>

                        <div class="track">
                            <div
                                class="track-fill"
                                style="
                                    width:${percentage}%;
                                    background:
                                        linear-gradient(
                                            90deg,
                                            ${color},
                                            ${color}aa
                                        );
                                "
                            ></div>
                        </div>

                        <div class="distribution-count">
                            ${count}
                        </div>

                    </div>
                `;
            }
        )
        .join("");
}


function renderRanking(
    elementId,
    rows
) {

    const element =
        document.getElementById(
            elementId
        );

    if (!rows || rows.length === 0) {

        element.innerHTML =
            '<li class="empty">' +
            'No data available.' +
            '</li>';

        return;
    }

    const topRows =
        rows.slice(0, 6);

    const maximum =
        Math.max(
            ...topRows.map(
                row => Number(row[1])
            ),
            1
        );

    element.innerHTML =
        topRows.map(
            ([name, count], index) => {

                const width =
                    (
                        Number(count)
                        / maximum
                    )
                    * 100;

                return `
                    <li class="ranking-item">

                        <span class="rank-number">
                            ${index + 1}
                        </span>

                        <div class="rank-info">

                            <div
                                class="rank-name"
                                title="${escapeHtml(name)}"
                            >
                                ${escapeHtml(name)}
                            </div>

                            <div class="rank-bar">
                                <div
                                    class="rank-bar-fill"
                                    style="width:${width}%"
                                ></div>
                            </div>

                        </div>

                        <span class="rank-count">
                            ${count}
                        </span>

                    </li>
                `;
            }
        )
        .join("");
}


function renderEndpoint(data) {

    const latest =
        data.recent_events?.[0];

    document.getElementById(
        "host-name"
    ).innerHTML =
        latest?.hostname
            ? (
                escapeHtml(
                    latest.hostname
                )
                +
                "<span>" +
                "Latest monitored Windows endpoint" +
                "</span>"
            )
            : (
                "Waiting for endpoint..." +
                "<span>" +
                "No Windows events received yet" +
                "</span>"
            );

    document.getElementById(
        "unique-ip"
    ).textContent =
        data.unique_destination_ips ?? 0;

    document.getElementById(
        "data-errors"
    ).textContent =
        data.data_errors?.length ?? 0;
}


function populateEventFilter(data) {

    const select =
        document.getElementById(
            "event-filter"
        );

    const previousValue =
        select.value;

    const eventTypes =
        Object.keys(
            data.event_counts ?? {}
        )
        .sort();

    select.innerHTML =
        '<option value="">' +
        'All events' +
        '</option>'
        +
        eventTypes.map(
            eventType => `
                <option
                    value="${escapeHtml(eventType)}"
                >
                    ${escapeHtml(eventType)}
                </option>
            `
        )
        .join("");

    if (
        eventTypes.includes(
            previousValue
        )
    ) {
        select.value =
            previousValue;
    }
}


function renderEvents() {

    const table =
        document.getElementById(
            "event-table"
        );

    if (!dashboardData) {
        return;
    }

    const searchValue =
        document.getElementById(
            "event-search"
        )
        .value
        .trim()
        .toLowerCase();

    const eventType =
        document.getElementById(
            "event-filter"
        ).value;

    const events =
        dashboardData.recent_events
        ?? [];

    const filtered =
        events.filter(
            event => {

                if (
                    eventType
                    &&
                    event.event_type
                    !== eventType
                ) {
                    return false;
                }

                if (!searchValue) {
                    return true;
                }

                const searchable = [
                    event.timestamp,
                    event.hostname,
                    event.event_type,
                    event.username,
                    event.process,
                    event.source_ip,
                    event.destination_ip,
                    event.target_file,
                    event.dns_query,
                    event.summary
                ]
                .join(" ")
                .toLowerCase();

                return searchable.includes(
                    searchValue
                );
            }
        );

    if (filtered.length === 0) {

        table.innerHTML = `
            <tr>
                <td
                    colspan="5"
                    class="empty"
                >
                    No matching events.
                </td>
            </tr>
        `;

        return;
    }

    table.innerHTML =
        filtered.map(
            event => {

                const identity =
                    event.username
                    ||
                    event.process
                    ||
                    "-";

                return `
                    <tr>

                        <td class="mono">
                            ${escapeHtml(
                                formatTimestamp(
                                    event.timestamp
                                )
                            )}
                        </td>

                        <td>
                            ${escapeHtml(
                                event.hostname
                            )}
                        </td>

                        <td>
                            <span
                                class="
                                    event-badge
                                    ${eventBadgeClass(
                                        event.event_type
                                    )}
                                "
                            >
                                ${escapeHtml(
                                    event.event_type
                                )}
                            </span>
                        </td>

                        <td class="mono">
                            ${escapeHtml(identity)}
                        </td>

                        <td>
                            ${escapeHtml(
                                event.summary
                            )}
                        </td>

                    </tr>
                `;
            }
        )
        .join("");
}


function renderDashboard(data) {

    dashboardData = data;

    renderKpis(data);
    renderDistribution(data);

    renderRanking(
        "process-ranking",
        data.top_processes
    );

    renderRanking(
        "ip-ranking",
        data.top_destination_ips
    );

    renderEndpoint(data);
    populateEventFilter(data);
    renderEvents();

    document.getElementById(
        "last-update"
    ).textContent =
        "Last update: "
        +
        new Date()
            .toLocaleTimeString();

    document.getElementById(
        "status-text"
    ).textContent =
        "Monitoring Online";

    document.getElementById(
        "api-health"
    ).textContent =
        "ONLINE";

    document.getElementById(
        "agent-health"
    ).textContent =
        data.total_events > 0
            ? "ONLINE"
            : "WAITING";
}


async function refreshDashboard() {

    const statusText =
        document.getElementById(
            "status-text"
        );

    const statusDot =
        document.getElementById(
            "status-dot"
        );

    try {

        const response =
            await fetch(
                "/api/dashboard",
                {
                    cache: "no-store"
                }
            );

        if (!response.ok) {
            throw new Error(
                `HTTP ${response.status}`
            );
        }

        const data =
            await response.json();

        statusDot.style.background =
            "var(--green)";

        renderDashboard(data);

    } catch (error) {

        statusText.textContent =
            "Dashboard API Offline";

        statusDot.style.background =
            "var(--red)";

        document.getElementById(
            "api-health"
        ).textContent =
            "OFFLINE";

        console.error(
            "Dashboard refresh failed:",
            error
        );
    }
}


document.getElementById(
    "event-search"
).addEventListener(
    "input",
    renderEvents
);


document.getElementById(
    "event-filter"
).addEventListener(
    "change",
    renderEvents
);


refreshDashboard();

setInterval(
    refreshDashboard,
    REFRESH_INTERVAL
);
</script>

</body>
</html>
