<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        WinWatch Security Dashboard
    </title>

    <style>
        :root {
            --background: #07111f;
            --panel: #0d1b2d;
            --panel-light: #13243a;
            --border: #203550;
            --text: #e6edf7;
            --muted: #8ca1ba;
            --blue: #39a5ff;
            --green: #36d399;
            --yellow: #f7c948;
            --red: #ff6b6b;
            --purple: #a78bfa;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family:
                Inter,
                "Segoe UI",
                Arial,
                sans-serif;
            color: var(--text);
            background:
                radial-gradient(
                    circle at top right,
                    #102847,
                    var(--background) 38%
                );
        }

        .container {
            width: min(1500px, 96%);
            margin: 0 auto;
            padding: 24px 0 40px;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 24px;
        }

        .brand h1 {
            margin: 0;
            font-size: 28px;
            letter-spacing: .4px;
        }

        .brand p {
            margin: 7px 0 0;
            color: var(--muted);
        }

        .status {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 10px 15px;
            border: 1px solid var(--border);
            background: var(--panel);
            border-radius: 10px;
        }

        .status-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--green);
            box-shadow:
                0 0 10px var(--green);
        }

        .cards {
            display: grid;
            grid-template-columns:
                repeat(4, minmax(0, 1fr));
            gap: 16px;
            margin-bottom: 16px;
        }

        .card,
        .panel {
            border: 1px solid var(--border);
            background:
                linear-gradient(
                    145deg,
                    var(--panel-light),
                    var(--panel)
                );
            border-radius: 14px;
        }

        .card {
            padding: 19px;
        }

        .card-label {
            color: var(--muted);
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: .8px;
        }

        .card-value {
            margin-top: 8px;
            font-size: 32px;
            font-weight: 700;
        }

        .blue {
            color: var(--blue);
        }

        .red {
            color: var(--red);
        }

        .green {
            color: var(--green);
        }

        .purple {
            color: var(--purple);
        }

        .grid {
            display: grid;
            grid-template-columns:
                1.3fr .7fr;
            gap: 16px;
            margin-bottom: 16px;
        }

        .panel {
            padding: 19px;
            min-width: 0;
        }

        .panel-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 17px;
        }

        .panel-title h2 {
            margin: 0;
            font-size: 17px;
        }

        .panel-title span {
            color: var(--muted);
            font-size: 12px;
        }

        .bar-row {
            display: grid;
            grid-template-columns:
                175px 1fr 55px;
            align-items: center;
            gap: 10px;
            margin: 11px 0;
            font-size: 13px;
        }

        .bar-label {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .bar-track {
            height: 9px;
            background: #07111f;
            border-radius: 20px;
            overflow: hidden;
        }

        .bar {
            height: 100%;
            border-radius: 20px;
            background:
                linear-gradient(
                    90deg,
                    var(--blue),
                    var(--purple)
                );
        }

        .bar-count {
            text-align: right;
            color: var(--muted);
        }

        .ranking {
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .ranking li {
            display: grid;
            grid-template-columns:
                28px 1fr auto;
            gap: 10px;
            align-items: center;
            padding: 11px 0;
            border-bottom:
                1px solid rgba(
                    255,
                    255,
                    255,
                    .06
                );
        }

        .ranking li:last-child {
            border-bottom: 0;
        }

        .rank {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 25px;
            height: 25px;
            border-radius: 7px;
            background: #162a42;
            color: var(--blue);
            font-weight: 600;
        }

        .rank-name {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .rank-count {
            color: var(--muted);
        }

        .table-wrap {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 900px;
        }

        th {
            text-align: left;
            padding: 11px 10px;
            color: var(--muted);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .6px;
            border-bottom:
                1px solid var(--border);
        }

        td {
            padding: 12px 10px;
            font-size: 12px;
            border-bottom:
                1px solid rgba(
                    255,
                    255,
                    255,
                    .055
                );
            vertical-align: middle;
        }

        tbody tr:hover {
            background:
                rgba(
                    57,
                    165,
                    255,
                    .05
                );
        }

        .event-badge {
            display: inline-block;
            border: 1px solid var(--border);
            background: #12273d;
            border-radius: 7px;
            padding: 5px 8px;
            white-space: nowrap;
            font-weight: 600;
        }

        .login-failure {
            color: var(--red);
        }

        .network {
            color: var(--blue);
        }

        .process {
            color: var(--green);
        }

        .dns {
            color: var(--purple);
        }

        .file {
            color: var(--yellow);
        }

        .muted {
            color: var(--muted);
        }

        .empty {
            padding: 24px;
            text-align: center;
            color: var(--muted);
        }

        footer {
            margin-top: 18px;
            text-align: center;
            color: var(--muted);
            font-size: 12px;
        }

        @media (max-width: 1000px) {
            .cards {
                grid-template-columns:
                    repeat(2, minmax(0, 1fr));
            }

            .grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 600px) {
            header {
                align-items: flex-start;
                flex-direction: column;
            }

            .cards {
                grid-template-columns: 1fr;
            }

            .bar-row {
                grid-template-columns:
                    130px 1fr 40px;
            }
        }
    </style>
</head>

<body>
<div class="container">

    <header>
        <div class="brand">
            <h1>
                WinWatch Security Dashboard
            </h1>

            <p>
                Real-Time Windows Activity Monitoring System
                · Nguyễn Thành Nhân
            </p>
        </div>

        <div class="status">
            <span
                class="status-dot"
                id="status-dot"
            ></span>

            <span id="status-text">
                Connecting...
            </span>
        </div>
    </header>

    <section class="cards">
        <article class="card">
            <div class="card-label">
                Total Events
            </div>

            <div
                class="card-value blue"
                id="total-events"
            >
                0
            </div>
        </article>

        <article class="card">
            <div class="card-label">
                Login Failures
            </div>

            <div
                class="card-value red"
                id="login-failures"
            >
                0
            </div>
        </article>

        <article class="card">
            <div class="card-label">
                Network Connections
            </div>

            <div
                class="card-value green"
                id="network-connections"
            >
                0
            </div>
        </article>

        <article class="card">
            <div class="card-label">
                Unique Processes
            </div>

            <div
                class="card-value purple"
                id="unique-processes"
            >
                0
            </div>
        </article>
    </section>

    <section class="grid">

        <article class="panel">
            <div class="panel-title">
                <h2>
                    Event Distribution
                </h2>

                <span>
                    Runtime telemetry
                </span>
            </div>

            <div id="event-chart">
                <div class="empty">
                    Waiting for events...
                </div>
            </div>
        </article>

        <article class="panel">
            <div class="panel-title">
                <h2>
                    Top Processes
                </h2>

                <span>
                    Most active
                </span>
            </div>

            <ol
                class="ranking"
                id="top-processes"
            ></ol>
        </article>

    </section>

    <section class="grid">

        <article class="panel">
            <div class="panel-title">
                <h2>
                    Top Destination IPs
                </h2>

                <span>
                    Network activity
                </span>
            </div>

            <ol
                class="ranking"
                id="top-ips"
            ></ol>
        </article>

        <article class="panel">
            <div class="panel-title">
                <h2>
                    Security Overview
                </h2>

                <span>
                    Current dataset
                </span>
            </div>

            <div class="bar-row">
                <div>
                    Unique Destination IPs
                </div>

                <div></div>

                <div
                    class="bar-count"
                    id="unique-ips"
                >
                    0
                </div>
            </div>

            <div class="bar-row">
                <div>
                    Data Errors
                </div>

                <div></div>

                <div
                    class="bar-count"
                    id="data-errors"
                >
                    0
                </div>
            </div>
        </article>

    </section>

    <section class="panel">
        <div class="panel-title">
            <h2>
                Recent Windows Events
            </h2>

            <span id="last-refresh">
                Waiting for data...
            </span>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                <tr>
                    <th>Time</th>
                    <th>Hostname</th>
                    <th>Event</th>
                    <th>User / Process</th>
                    <th>Details</th>
                </tr>
                </thead>

                <tbody id="event-table"></tbody>
            </table>
        </div>
    </section>

    <footer>
        WinWatch · Python Cybersecurity Project ·
        Auto-refresh every 2 seconds
    </footer>

</div>

<script>
    "use strict";

    const refreshIntervalMs = 2000;

    function escapeHtml(value) {
        return String(value ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    function eventClass(eventType) {
        if (eventType === "LOGIN_FAILURE") {
            return "login-failure";
        }

        if (eventType.includes("NETWORK")) {
            return "network";
        }

        if (eventType.includes("PROCESS")) {
            return "process";
        }

        if (eventType.includes("DNS")) {
            return "dns";
        }

        if (eventType.includes("FILE")) {
            return "file";
        }

        return "";
    }

    function renderEventChart(counts) {
        const container =
            document.getElementById(
                "event-chart"
            );

        const entries =
            Object.entries(counts || {});

        if (entries.length === 0) {
            container.innerHTML =
                '<div class="empty">' +
                'No runtime events yet.' +
                '</div>';

            return;
        }

        const maxValue =
            Math.max(
                ...entries.map(
                    ([, count]) => count
                ),
                1
            );

        container.innerHTML =
            entries
                .sort(
                    (a, b) => b[1] - a[1]
                )
                .map(([name, count]) => {
                    const width =
                        Math.max(
                            2,
                            (
                                count /
                                maxValue
                            ) * 100
                        );

                    return `
                        <div class="bar-row">
                            <div
                                class="bar-label"
                                title="${escapeHtml(name)}"
                            >
                                ${escapeHtml(name)}
                            </div>

                            <div class="bar-track">
                                <div
                                    class="bar"
                                    style="width:${width}%"
                                ></div>
                            </div>

                            <div class="bar-count">
                                ${count}
                            </div>
                        </div>
                    `;
                })
                .join("");
    }

    function renderRanking(
        elementId,
        rows
    ) {
        const element =
            document.getElementById(
                elementId
            );

        if (!rows || rows.length === 0) {
            element.innerHTML =
                '<li class="muted">' +
                'No data available.' +
                '</li>';

            return;
        }

        element.innerHTML =
            rows.slice(0, 5)
                .map(
                    ([name, count], index) => `
                        <li>
                            <span class="rank">
                                ${index + 1}
                            </span>

                            <span
                                class="rank-name"
                                title="${escapeHtml(name)}"
                            >
                                ${escapeHtml(name)}
                            </span>

                            <span class="rank-count">
                                ${count}
                            </span>
                        </li>
                    `
                )
                .join("");
    }

    function renderEvents(events) {
        const table =
            document.getElementById(
                "event-table"
            );

        if (!events || events.length === 0) {
            table.innerHTML = `
                <tr>
                    <td
                        colspan="5"
                        class="empty"
                    >
                        Waiting for Windows events...
                    </td>
                </tr>
            `;

            return;
        }

        table.innerHTML =
            events.map(event => {
                const identity =
                    event.username ||
                    event.process ||
                    "-";

                return `
                    <tr>
                        <td class="muted">
                            ${escapeHtml(event.timestamp)}
                        </td>

                        <td>
                            ${escapeHtml(event.hostname)}
                        </td>

                        <td>
                            <span
                                class="
                                    event-badge
                                    ${eventClass(
                                        event.event_type
                                    )}
                                "
                            >
                                ${escapeHtml(
                                    event.event_type
                                )}
                            </span>
                        </td>

                        <td>
                            ${escapeHtml(identity)}
                        </td>

                        <td>
                            ${escapeHtml(
                                event.summary
                            )}
                        </td>
                    </tr>
                `;
            }).join("");
    }

    async function refreshDashboard() {
        const statusText =
            document.getElementById(
                "status-text"
            );

        const statusDot =
            document.getElementById(
                "status-dot"
            );

        try {
            const response =
                await fetch(
                    "/api/dashboard",
                    {
                        cache: "no-store"
                    }
                );

            if (!response.ok) {
                throw new Error(
                    `HTTP ${response.status}`
                );
            }

            const data =
                await response.json();

            statusText.textContent =
                "Monitoring Online";

            statusDot.style.background =
                "var(--green)";

            document.getElementById(
                "total-events"
            ).textContent =
                data.total_events;

            document.getElementById(
                "login-failures"
            ).textContent =
                data.login_failures;

            document.getElementById(
                "network-connections"
            ).textContent =
                data.network_connections;

            document.getElementById(
                "unique-processes"
            ).textContent =
                data.unique_processes;

            document.getElementById(
                "unique-ips"
            ).textContent =
                data.unique_destination_ips;

            document.getElementById(
                "data-errors"
            ).textContent =
                data.data_errors.length;

            renderEventChart(
                data.event_counts
            );

            renderRanking(
                "top-processes",
                data.top_processes
            );

            renderRanking(
                "top-ips",
                data.top_destination_ips
            );

            renderEvents(
                data.recent_events
            );

            document.getElementById(
                "last-refresh"
            ).textContent =
                "Updated " +
                new Date()
                    .toLocaleTimeString();

        } catch (error) {
            statusText.textContent =
                "Dashboard API Offline";

            statusDot.style.background =
                "var(--red)";

            console.error(error);
        }
    }

    refreshDashboard();

    setInterval(
        refreshDashboard,
        refreshIntervalMs
    );
</script>

</body>
</html>
